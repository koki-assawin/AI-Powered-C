rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write their own document; admin can write any; teachers can update enrolledCourses only
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow update: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enrolledCourses']);
    }

    // Courses — authenticated users can read; teachers/admins can write
    match /courses/{courseId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Assignments — authenticated users can read; teachers/admins can write
    match /assignments/{assignmentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Test cases — all authenticated users can read (grading is client-side; hidden flag controls UI only)
    match /testCases/{testCaseId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Submissions — students write own; admin can write for seeding
    match /submissions/{submissionId} {
      allow create: if request.auth != null && (
        request.resource.data.studentId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow read: if request.auth != null && (
        resource.data.studentId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      // นักเรียนแก้ได้เฉพาะงานของตัวเอง และเฉพาะ field ที่เป็นข้อมูลเชิงกระบวนการ
      // (คะแนนจากการตรวจ โค้ด และผลเทสต์ ยังแก้ไม่ได้)
      allow update: if request.auth != null
        && resource.data.studentId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['aiScore', 'aiMetrics', 'runCount', 'timeSpentSeconds', 'hintLevelUsed']);
      allow update, delete: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Grades — students read own; teachers/admins read+write all
    match /grades/{gradeId} {
      allow read: if request.auth != null && (
        resource.data.studentId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      // รายวิชาที่ปิดรับคะแนนแล้ว (courses.gradesLocked == true) นักเรียนแก้คะแนนไม่ได้อีก
      // ครูและผู้ดูแลระบบยังแก้ได้ เผื่อต้องปรับคะแนนภายหลัง
      // ใช้ data.get(..., false) เพราะรายวิชาที่สร้างใหม่ยังไม่มี field gradesLocked
      // (อ่าน field ที่ไม่มีอยู่ตรงๆ จะเกิด error และ rule จะปฏิเสธการเขียนทันที)
      allow write: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.get('gradesLocked', false) != true
      );
    }

    // Enrollments — all authenticated can read (leaderboard needs full class list); write own
    match /enrollments/{enrollmentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Config — read by authenticated; gemini doc also readable without auth (key used client-side for demo AI)
    match /config/{docId} {
      allow read: if request.auth != null || docId == 'gemini';
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // App Config (demo setup, system settings) — authenticated read; teachers/admins write
    match /appConfig/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Lessons — read by authenticated; write by teachers/admins
    match /lessons/{lessonId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // SelfPractice submissions — students read own; teachers/admins read all; authenticated write
    match /selfPracticeSubmissions/{docId} {
      allow read: if request.auth != null && (
        resource.data.studentId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow write: if request.auth != null;
    }

    // Classes — all authenticated users read; teachers/admins write
    match /classes/{classId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Player stats — all authenticated users can read (leaderboard); write own or admin
    match /playerStats/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // XP ledger — students create own; admin can create any (for research seeding)
    match /xpLedger/{docId} {
      allow create: if request.auth != null && (
        request.resource.data.uid == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow read: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Leaderboard snapshots — all authenticated can read; students trigger update via gamification.js (write)
    match /leaderboardSnapshots/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Achievements catalog — all authenticated read; admin write
    match /achievements/{achId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Student achievements — students create own; admin write any (seeding); teachers/admins read all
    match /studentAchievements/{docId} {
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow read: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Coach interactions — students create own; read own; teachers/admins read all (research data)
    match /coachInteractions/{docId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Seasons — authenticated read; teachers/admins write
    match /seasons/{seasonId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Mini-game content — authenticated read (cached AI content); teachers/admins write
    match /miniGameContent/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Mini-game sessions — students create own; admin create any (seeding); read own; teachers/admins read all
    match /miniGameSessions/{docId} {
      allow create: if request.auth != null && (
        request.resource.data.uid == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow read: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Multi-activity assignments v2 — authenticated read; teachers/admins write
    match /assignments_v2/{assignmentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Submissions v2 — students create own; read own; teachers/admins read+write all
    match /submissions_v2/{submissionId} {
      allow create: if request.auth != null && (
        request.resource.data.studentId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow read: if request.auth != null && (
        resource.data.studentId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow update, delete: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Class analytics — teachers/admins read; authenticated write (client-side aggregation)
    match /class_analytics/{docId} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow write: if request.auth != null;
    }

    // Runtime status — students write own; teachers/admins read all (real-time alerts)
    match /runtimeStatus/{uid} {
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Learning topics (Content CMS) — students read published; teachers/admins write
    match /learningTopics/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Usage Events — authenticated users log own events; demo events allowed without auth (uid='demo' only)
    match /usageEvents/{docId} {
      allow create: if request.auth != null ||
        (request.resource.data.uid == 'demo' &&
         request.resource.data.event in ['demo_run','ai_analyze','ai_hint','ai_chat'] &&
         request.resource.data.keys().hasOnly(['uid','event','date','problemId','userType','timestamp','lang','hintLevel','question']));
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Poll templates (QuickPoll question bank) — authenticated read; teachers/admins write
    match /pollTemplates/{templateId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Poll sessions (QuickPoll one-time use) — authenticated read; teachers/admins write
    match /pollSessions/{sessionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );

      // Responses — students write only their own doc, only while a round is open; teachers/admins read all
      match /responses/{uid} {
        allow read: if request.auth != null && (
          request.auth.uid == uid ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        );
        allow create, update: if request.auth != null && request.auth.uid == uid &&
          get(/databases/$(database)/documents/pollSessions/$(sessionId)).data.status in ['round1_open', 'round2_open'];
        allow delete: if request.auth != null && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        );
      }
    }

    // ══ APCC Studio v6.0 — บล็อกใหม่ทั้งหมด (ไม่แก้กฎเดิมด้านบน) ══════════════════

    // Studio templates — คลังชุดโจทย์ (มีเฉลย) อ่านได้เฉพาะครู/แอดมิน; เจ้าของหรือแอดมินแก้/ลบได้
    match /studio_templates/{templateId} {
      allow read, create: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow update, delete: if request.auth != null && (
        resource.data.get('ownerId', '') == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Studio events — log ของ Studio แยกจาก usageEvents; สร้างได้เฉพาะของตนเอง อ่านได้เฉพาะครู/แอดมิน ไม่มีการแก้/ลบ
    match /studio_events/{eventId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Studio skill gates — ทุกคนที่ล็อกอินอ่านได้ (นักเรียนต้องเห็นด่าน); ครู/แอดมินเขียน
    match /studio_skillGates/{gateDocId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Studio progress — id = {courseId}_{uid}; นักเรียนอ่าน/เขียนเฉพาะของตนเอง ครู/แอดมินอ่าน-เขียนได้ทั้งหมด
    // (เช็คจาก id แทน resource เพื่อให้นักเรียนอ่านเอกสารที่ยังไม่มีได้)
    match /studio_progress/{progressId} {
      allow read: if request.auth != null && (
        progressId.matches('^.+_' + request.auth.uid + '$') ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow create, update: if request.auth != null && (
        (request.resource.data.uid == request.auth.uid &&
         progressId == request.resource.data.courseId + '_' + request.auth.uid) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Explain-Back — นักเรียนสร้าง/อ่านของตนเอง แก้ได้เฉพาะคำตอบคำถามต่อ; ครู/แอดมินอ่านและแก้ได้ทั้งหมด
    match /studio_explainBack/{ebId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow update: if request.auth != null && (
        (resource.data.uid == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followUpAnswer', 'updatedAt'])) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Project teams (TeamSync เดิม ไม่เคยมีกฎ จึงใช้งานไม่ได้) — ข้อตัดสินใจ D2
    // ทุกคนที่ล็อกอินอ่านได้ (ต้องอ่านเพื่อเข้าร่วมด้วยรหัสทีม); สร้างได้เมื่อเป็นผู้สร้างและอยู่ในทีม;
    // แก้ได้เฉพาะ members/memberNames และต้องเป็นสมาชิกก่อนหรือหลังการแก้ (เข้าร่วม/ออก); ครู/แอดมินแก้ได้ทั้งหมด
    match /projectTeams/{teamId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.members.hasAll([request.auth.uid]);
      allow update: if request.auth != null && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames']) &&
         (resource.data.members.hasAny([request.auth.uid]) || request.resource.data.members.hasAny([request.auth.uid]))) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow delete: if request.auth != null && (
        resource.data.createdBy == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );

      match /tasks/{taskId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (
          get(/databases/$(database)/documents/projectTeams/$(teamId)).data.members.hasAny([request.auth.uid]) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        );
      }
      match /feedback/{feedbackId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null &&
          request.resource.data.fromUid == request.auth.uid &&
          get(/databases/$(database)/documents/projectTeams/$(teamId)).data.members.hasAny([request.auth.uid]);
        allow update, delete: if request.auth != null && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        );
      }
    }

    // Studio projects — id = {courseId}_{teamId}; ทุกคนที่ล็อกอินอ่านได้ (ประเมินโดยเพื่อน/แกลเลอรี);
    // สมาชิกปัจจุบันของทีม (ตรวจจาก projectTeams) สร้าง/แก้ได้ แต่เปลี่ยน courseId/teamId ไม่ได้; ครู/แอดมินแก้ได้ทั้งหมด
    match /studio_projects/{projectId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.createdBy == request.auth.uid &&
        projectId == request.resource.data.courseId + '_' + request.resource.data.teamId &&
        get(/databases/$(database)/documents/projectTeams/$(request.resource.data.teamId)).data.members.hasAny([request.auth.uid]);
      allow update: if request.auth != null && (
        (get(/databases/$(database)/documents/projectTeams/$(resource.data.teamId)).data.members.hasAny([request.auth.uid]) &&
         request.resource.data.courseId == resource.data.courseId &&
         request.resource.data.teamId == resource.data.teamId) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow delete: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );

      match /versions/{versionId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null &&
          request.resource.data.createdBy == request.auth.uid &&
          get(/databases/$(database)/documents/projectTeams/$(get(/databases/$(database)/documents/studio_projects/$(projectId)).data.teamId)).data.members.hasAny([request.auth.uid]);
        allow update, delete: if request.auth != null && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        );
      }
    }

    // Studio rubrics — ทุกคนที่ล็อกอินอ่านได้; ครู/แอดมินเขียน
    match /studio_rubrics/{rubricId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Studio reviews — ครูประเมิน (เผยแพร่เมื่อ published) / เพื่อนประเมิน (ห้ามประเมินทีมตนเอง)
    // อ่าน: ผู้ประเมินเอง, ครู/แอดมิน, สมาชิกทีมเห็นผลของครูที่เผยแพร่แล้ว และคำแนะนำจากเพื่อน
    match /studio_reviews/{reviewId} {
      allow read: if request.auth != null && (
        resource.data.reviewerUid == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        ((resource.data.reviewerType == 'peer' || resource.data.published == true) &&
         get(/databases/$(database)/documents/studio_projects/$(resource.data.projectId)).data.members.hasAny([request.auth.uid]))
      );
      allow create, update: if request.auth != null && (
        (request.resource.data.reviewerType == 'peer' &&
         request.resource.data.reviewerUid == request.auth.uid &&
         reviewId == request.resource.data.projectId + '_peer_' + request.auth.uid &&
         !get(/databases/$(database)/documents/studio_projects/$(request.resource.data.projectId)).data.members.hasAny([request.auth.uid])) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow delete: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Studio showcase — แกลเลอรีผลงานที่ครูอนุมัติ: ทุกคนที่ล็อกอินอ่านได้, ครู/แอดมินเท่านั้นที่เขียน
    match /studio_showcase/{showcaseId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow delete: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }
  }
}
